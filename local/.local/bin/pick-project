#!/usr/bin/env bash
# Print an absolute project path; cancellation succeeds with no output.
set -euo pipefail

if [[ $# -gt 1 || ( $# -eq 1 && "$1" != --list ) ]]; then
  printf 'Usage: pick-project [--list]\n' >&2
  exit 2
fi

candidates() {
  # Preserve zoxide's ranking and the same roots as the Herdr picker. Compare
  # literal prefixes so punctuation in HOME is never treated as a regex.
  zoxide query -l | awk -v home="$HOME/" '
    index($0, home) == 1 {
      relative = substr($0, length(home) + 1)
      lower = tolower(relative)
      if (lower ~ /^(\.dotfiles[^\/]*|\.config|documents\/(development|obsidian-vaults|gateway))(\/|$)/ &&
          lower !~ /(^|\/)node_modules(\/|$)/ && !seen[$0]++) print relative
    }
  '
}

if [[ "${1:-}" == --list ]]; then
  candidates
  exit
fi

# Read the shared theme without loading an interactive shell or rewriting
# current_theme. Every sessionizer uses the same layout and colors.
fzf_config="$HOME/.config/fzf"
fzf_theme=rose
[[ ! -f "$fzf_config/current_theme" ]] || fzf_theme=$(<"$fzf_config/current_theme")
[[ -f "$fzf_config/themes/$fzf_theme.sh" ]] || fzf_theme=rose
if [[ -f "$fzf_config/themes/$fzf_theme.sh" ]]; then
  FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-}"
  FZF_THEME_OPTS=""
  source "$fzf_config/themes/$fzf_theme.sh" >&2
  export FZF_DEFAULT_OPTS="${FZF_THEME_OPTS:-$FZF_DEFAULT_OPTS}"
fi
directories=$(candidates)
[[ -n "$directories" ]] || exit 0
status=0
selected=$(printf '%s\n' "$directories" | ESCDELAY=10 fzf --no-sort --no-multi --border --layout=reverse) || status=$?
case $status in
  0) ;;
  1|130) exit 0 ;;
  *) printf 'fzf failed (exit %s).\n' "$status" >&2; exit "$status" ;;
esac
[[ -n "$selected" ]] || exit 0
printf '%s\n' "$HOME/$selected"
