#!/usr/bin/env bash

set -euo pipefail

HERDR_BIN="${HERDR_BIN_PATH:-herdr}"

if [[ $# -eq 1 ]]; then
  selected="$1"
else
  selected=$(
    zoxide query -l |
      grep "^$HOME/" |
      grep -i -E \
        "^$HOME/\.dotfiles|^$HOME/\.config|^$HOME/documents/development|^$HOME/documents/obsidian-vaults" |
      grep -v "node_modules" |
      sed -E "s;^$HOME/;;; s/^[0-9.]+[[:space:]]+//" |
      fzf \
        --no-sort \
        --border |
      sed "s|^|$HOME/|"
  )
fi

[[ -n "${selected:-}" ]] || exit 0
[[ -d "$selected" ]] || {
  printf 'Not a directory: %s\n' "$selected" >&2
  exit 1
}

# Normalise the path before deriving the workspace label.
selected="$(cd "$selected" && pwd -P)"
selected_name="$(basename "$selected")"

workspaces_json=$("$HERDR_BIN" workspace list 2>/dev/null)
panes_json=$("$HERDR_BIN" pane list 2>/dev/null)
workspace_id=$(
  printf '%s\n%s\n' "$workspaces_json" "$panes_json" |
    jq -s -r '
      def items($document; $key):
        if ($document | type) == "array" then
          $document
        elif ($document | type) == "object" then
          ($document.result[$key] // $document[$key] //
            (if ($document.result | type) == "array" then $document.result else [] end))
        else
          []
        end;

      items(.[0]; "workspaces") as $workspaces
      | items(.[1]; "panes") as $panes
      | $workspaces[]
      | select(type == "object")
      | (.workspace_id // .id // "") as $id
      | ($panes | map(select((.workspace_id // "") == $id))) as $workspace_panes
      | ([
          .cwd,
          ($workspace_panes | map(.cwd // empty) | map(select(length > 0)) | .[0]),
          .foreground_cwd,
          ($workspace_panes | map(.foreground_cwd // empty) | map(select(length > 0)) | .[0])
        ] | map(select(type == "string" and length > 0)) | .[0] // "") as $cwd
      | [$id, $cwd, (.label // "")]
      | join("\u001f")
    ' |
    (
      matched_id=""
      fallback_id=""
      fallback_count=0

      while IFS=$'\x1f' read -r id cwd label; do
        [[ -n "$id" ]] || continue

        if [[ -n "$cwd" && -d "$cwd" ]]; then
          cwd="$(cd "$cwd" && pwd -P)"
          if [[ "$cwd" == "$selected" ]]; then
            matched_id="$id"
            break
          fi
        fi

        if [[ "$label" =~ ^\[[0-9]+\][[:space:]]*(.*)$ ]]; then
          label="${BASH_REMATCH[1]}"
        fi
        if [[ "$label" == "$selected_name" ]]; then
          fallback_id="$id"
          fallback_count=$((fallback_count + 1))
        fi
      done

      if [[ -n "$matched_id" ]]; then
        printf '%s\n' "$matched_id"
      elif [[ "$fallback_count" -eq 1 ]]; then
        printf '%s\n' "$fallback_id"
      fi
    )
)

if [[ -n "$workspace_id" ]]; then
  "$HERDR_BIN" workspace focus "$workspace_id" >/dev/null
else
  "$HERDR_BIN" workspace create \
    --cwd "$selected" \
    --label "$selected_name" \
    --focus >/dev/null
fi
