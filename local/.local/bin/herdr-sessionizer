#!/usr/bin/env bash

set -euo pipefail

HERDR_BIN="${HERDR_BIN_PATH:-herdr}"

if [[ $# -eq 1 ]]; then
  selected="$1"
else
  selected=$(
    zoxide query -l |
      grep "^$HOME/" |
      grep -i -E \
        "^$HOME/\.dotfiles|^$HOME/\.config|^$HOME/documents/development|^$HOME/documents/obsidian-vaults" |
      grep -v "node_modules" |
      sed -E "s;^$HOME/;;; s/^[0-9.]+[[:space:]]+//" |
      fzf \
        --no-sort \
        --border |
      sed "s|^|$HOME/|"
  )
fi

[[ -n "${selected:-}" ]] || exit 0
[[ -d "$selected" ]] || {
  printf 'Not a directory: %s\n' "$selected" >&2
  exit 1
}

# Normalise the path so workspace matching is reliable.
selected="$(cd "$selected" && pwd -P)"
selected_name="$(basename "$selected" | tr '.' '_')"

workspace_id=$(
  "$HERDR_BIN" workspace list 2>/dev/null |
    jq -r --arg cwd "$selected" '
      def workspaces:
        if type == "array" then .
        elif type == "object" then
          (.result.workspaces // .workspaces // .result // [])
        else
          []
        end;

      workspaces[]
      | select(type == "object")
      | select(
          (.cwd // .root_cwd // .path // "")
          == $cwd
        )
      | (.workspace_id // .id // empty)
    ' |
    head -n 1
)

if [[ -n "$workspace_id" ]]; then
  "$HERDR_BIN" workspace focus "$workspace_id" >/dev/null
else
  "$HERDR_BIN" workspace create \
    --cwd "$selected" \
    --label "$selected_name" \
    --focus >/dev/null
fi
