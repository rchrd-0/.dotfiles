#!/usr/bin/env bash
# Requires the local Rex sessionizer_go action.
set -euo pipefail

client="${REX_CLIENT:-}"
list_only=false
selected=""

usage() {
  printf 'Usage: rex-sessionizer [--client CLIENT] [--list | DIRECTORY]\n' >&2
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --client) [[ $# -ge 2 && -n "$2" ]] || usage; client=$2; shift 2 ;;
    --list) list_only=true; shift ;;
    --) shift; [[ $# -eq 1 && -z "$selected" ]] || usage; selected=$1; shift ;;
    -*) usage ;;
    *) [[ -z "$selected" && -n "$1" ]] || usage; selected=$1; shift ;;
  esac
done
[[ $list_only == false || -z "$selected" ]] || usage

if $list_only; then
  exec pick-project --list
fi

# Keep failures readable in the floating terminal, while cancellation is quiet.
finish() {
  local status=$?
  trap - EXIT
  if [[ $status -ne 0 && -t 0 && -n "$client" ]]; then
    printf '\nSessionizer failed. Press Enter to close…' >&2
    read -r _ || true
  fi
  exit "$status"
}
trap finish EXIT

if [[ -z "$selected" ]]; then
  selected=$(pick-project)
  [[ -n "$selected" ]] || exit 0
fi

[[ -d "$selected" ]] || { printf 'Not a directory: %s\n' "$selected" >&2; exit 1; }
# Lua canonicalizes once for both picker callbacks and direct action calls.
[[ "$selected" == /* ]] || selected="$PWD/$selected"
rex_args=(--autostart=false)
action_args=("path=$selected")
if [[ -n "$client" ]]; then
  rex_args+=(-C "$client")
  action_args+=("client=$client")
fi
rex "${rex_args[@]}" do sessionizer_go "${action_args[@]}"
