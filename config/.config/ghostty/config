# vim: set filetype=conf:

theme = "Rose Pine"

font-family = TX02 Nerd Font
# font-family = CaskaydiaCove Nerd Font Mono
# font-family = JetBrainsMono Nerd Font Mono
# font-family = BlexMono Nerd Font Mono
font-feature = -liga
font-feature = -dlig
font-feature = -calt
font-feature = +cv14
font-size = 13
font-thicken = true
font-thicken-strength = 128
adjust-cell-height = 0%

# background-opacity = 0.97
# background-blur = true

cursor-style = block
cursor-style-blink = false
cursor-click-to-move = true
mouse-hide-while-typing = true
shell-integration = zsh
shell-integration-features = no-cursor
link-url = true
window-padding-x = 16
window-padding-y = 8
copy-on-select = clipboard

macos-titlebar-style = transparent
macos-window-shadow = true
macos-icon = xray
# macos-icon-ghost-color = e0def4
# macos-icon-screen-color = 191724,1f1d2e,31748f
# macos-icon-frame = chrome
macos-option-as-alt = true

quick-terminal-position = top
quick-terminal-size = 40%
quick-terminal-animation-duration = 0

keybind = global:cmd+shift+`=toggle_quick_terminal
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = alt+backspace=text:\x1b\x7f
keybind = shift+enter=text:\n

bell-features = attention,audio
bell-audio-path = /System/Library/Sounds/Hero.aiff
bell-audio-volume = 0.25
