[submodule "config/.config/tmux/plugins/tpm"]
	path = config/.config/tmux/plugins/tpm
	url = https://github.com/tmux-plugins/tpm
[submodule "config/.config/nvim"]
	path = config/.config/nvim
	url = git@github.com:rchrd-0/nvim.git
	branch = v2-lazyvim
[submodule "zsh/.zsh/private"]
	path = zsh/.zsh/private
	url = git@github.com:rchrd-0/zsh-private.git
